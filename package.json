    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.0.0",
    "puppeteer-core": "^25.9.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
